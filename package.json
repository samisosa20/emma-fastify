{
  "name": "fiona-node-api-ts",
  "description": "Simple api sample in Node",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "start": "node -r tsconfig-paths/register dist/src/index.js",
    "deploy:prod": "npm run migrate:deploy && npm run build && pm2 describe fiona-backend > /dev/null && pm2 restart fiona-backend || pm2 start --name fiona-backend --watch --node-args='-r tsconfig-paths/register' dist/src/index.js && pm2 save"
  },
  "author": "Sammy Guttman",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.20",
    "dotenv": "^18.0.10",
    "express": "5.3.0",
    "fastify": "^5.12.8",
    "mariadb": "^3.5.5",
    "mysql2": "3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "pm2": "7.1.2",
    "prisma-extension-pagination": "^0.7.6",
    "swagger-themes": "^1.4.3",
    "tsconfig-paths": "^4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "oxlint": "^1.93.0",
    "prisma": "^7.10.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
