{
  "name": "fiona-node-api-ts",
  "description": "Simple api sample in Node",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc-alias",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "start": "node -r tsconfig-paths/register dist/src/index.js",
    "deploy:prod": "npm run migrate:deploy && npm run build && pm2 describe fiona-backend > /dev/null && pm2 restart fiona-backend || pm2 start --name fiona-backend --watch --node-args='-r tsconfig-paths/register' dist/src/index.js && pm2 save"
  },
  "author": "Sammy Guttman",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.9",
    "express": "5.3.0",
    "fastify": "^5.12.7",
    "mariadb": "^3.5.4",
    "mysql2": "3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "prisma-extension-pagination": "^0.7.6",
    "swagger-themes": "^1.4.3",
    "tsconfig-paths": "^4.2.0",
    "pm2": "7.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "typescript": "7.0.2"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src",
      "packages"
    ],
    "exec": "node -r tsconfig-paths/register -r ts-node/register ./src/index.ts",
    "ext": "ts, js"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
