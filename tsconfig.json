{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./*"],
      "@routes": ["./src/routes"],
      "@controllers": ["./src/controllers"],
      "@lib": ["./src/lib"],
      "@lib/*": ["./src/lib/*"],
      "@packages": ["./packages"]
    }
  },
  "include": ["src/**/*.ts", "packages/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/*.d.ts",
    "**/*.spec.ts"
  ]
}